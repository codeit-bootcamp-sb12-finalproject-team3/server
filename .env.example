# Spring Profile
SPRING_PROFILES_ACTIVE=dev


# Database
DB_NAME=moduplaylist
DB_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/moduplaylist?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=mopl
DB_PASSWORD=mopl
DB_ROOT_PASSWORD=root


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379


# Kafka
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# OpenSearch
OPENSEARCH_ENABLED=true
CONTENT_INITIAL_INDEXING_ENABLED=false
OPENSEARCH_URIS=http://localhost:9200


# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=


# External content APIs
TMDB_ACCESS_TOKEN=
SPORTS_DB_API_KEY=123
CONTENT_IMPORT_SCHEDULER_ENABLED=true
CONTENT_IMPORT_CRON=0 0 0 * * *


# AI
OPENAI_API_KEY=
# Enable only on one app-batch instance.
CONTENT_TAGGING_ENABLED=true
CONTENT_TAGGING_CRON=0 * 0-2 * * *
CONTENT_TAGGING_MODEL=gpt-6-luna
CONTENT_TAGGING_RESEARCH_ENABLED=true
CONTENT_TAGGING_RESEARCH_MODEL=gpt-6-luna
CONTENT_TAGGING_RESEARCH_TIMEOUT_SECONDS=30
CONTENT_TAGGING_RESEARCH_MAX_TOKENS=3000
CONTENT_TAGGING_RESEARCH_MAX_FACTS=6
CONTENT_TAGGING_RESEARCH_MAX_SOURCES=5
CONTENT_TAGGING_RESEARCH_CACHE_DAYS=90

# Content embeddings start at 02:00 Asia/Seoul.
EMBEDDING_SCHEDULER_ENABLED=true
CONTENT_EMBEDDING_CRON=0 0 2 * * *

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
