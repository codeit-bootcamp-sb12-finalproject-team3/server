# Spring Profile
SPRING_PROFILES_ACTIVE=dev


# Database
DB_NAME=moduplaylist
DB_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/moduplaylist?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=root


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379


# Kafka
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092


# OpenSearch
OPENSEARCH_ENABLED=true
CONTENT_INITIAL_INDEXING_ENABLED=false
OPENSEARCH_URIS=http://localhost:9200


# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=


# External content APIs
TMDB_ACCESS_TOKEN=
SPORTS_DB_API_KEY=123
CONTENT_IMPORT_SCHEDULER_ENABLED=false


# AI
OPENAI_API_KEY=
# Enable only when app-batch runs as a single EC2 process.
CONTENT_TAGGING_ENABLED=false
CONTENT_TAGGING_CRON=0 * * * * *
CONTENT_TAGGING_MODEL=gpt-4o-mini
