{
  "settings": {
    "index": {
      "knn": true,
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "analysis": {
      "char_filter": {
        "remove_whitespace": {
          "type": "pattern_replace",
          "pattern": "\\s+",
          "replacement": ""
        }
      },
      "normalizer": {
        "content_exact": {
          "type": "custom",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "tokenizer": {
        "content_nori_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        }
      },
      "filter": {
        "tag_synonyms": {
          "type": "synonym_graph",
          "synonyms": [
            "mcu, marvel, 마블",
            "dceu, dcu, dc, 디씨",
            "lotr, the lord of the rings, 반지의 제왕",
            "twd, the walking dead, 워킹 데드",
            "tlou, the last of us, 라스트 오브 어스",
            "tmnt, teenage mutant ninja turtles, 닌자 거북이, 닌자터틀",
            "gotg, guardians of the galaxy, 가디언즈 오브 갤럭시"
          ]
        }
      },
      "analyzer": {
        "content_korean_index": {
          "type": "custom",
          "tokenizer": "content_nori_tokenizer",
          "filter": ["lowercase"]
        },
        "content_korean_search": {
          "type": "custom",
          "tokenizer": "content_nori_tokenizer",
          "filter": ["lowercase"]
        },
        "content_english": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "content_compact": {
          "type": "custom",
          "char_filter": ["remove_whitespace"],
          "tokenizer": "keyword",
          "filter": ["lowercase", "asciifolding"]
        },
        "content_synonym_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "tag_synonyms"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "contentId": { "type": "keyword" },
      "type": { "type": "keyword" },
      "title": {
        "type": "text",
        "analyzer": "content_korean_index",
        "search_analyzer": "content_korean_search",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "content_exact",
            "ignore_above": 255
          },
          "compact": {
            "type": "text",
            "analyzer": "content_compact",
            "search_analyzer": "content_compact"
          }
